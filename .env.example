# RailGaadi Environment Configuration
# External API keys. Without them, the related live feature returns an
# unavailable state; no simulated train data is shown to users.
NEXT_PUBLIC_MAPTILER_KEY=
RAILRADAR_API_KEY=
OPENWEATHER_API_KEY=
OPENTOPOGRAPHY_API_KEY=
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# Set only for local visual development. Never enable this in production.
USE_MOCK_DATA=false

# Application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional production services
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
